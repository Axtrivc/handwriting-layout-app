{
  "name": "handwriting-layout-app",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "合规的本地桌面应用：个人笔记美化、扫描稿恢复、模板重排版、个人手写风格排版。",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "install:all": "pnpm install && pnpm --filter @hw-layout/shared build",
    "dev:web": "pnpm --filter @hw-layout/web dev",
    "dev:desktop": "pnpm --filter @hw-layout/desktop dev",
    "dev:api": "node scripts/run-api.mjs",
    "build:shared": "pnpm --filter @hw-layout/shared build",
    "build:web": "pnpm --filter @hw-layout/shared build && pnpm --filter @hw-layout/web build",
    "build:desktop": "pnpm build:web && pnpm --filter @hw-layout/desktop build:desktop",
    "build:api": "node scripts/build-api.mjs",
    "package:desktop": "pnpm build:api && pnpm build:desktop && pnpm --filter @hw-layout/desktop package:desktop",
    "package:dist": "pnpm build:api && pnpm build:desktop && pnpm --filter @hw-layout/desktop package:dist",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "build": "pnpm --filter @hw-layout/shared build && pnpm -r build",
    "test:unit": "pnpm build:desktop && node scripts/run-unit-tests.mjs",
    "test:e2e": "pnpm build:shared && node scripts/run-browser-tests.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "playwright": "^1.64.1",
    "typescript-eslint": "^8.18.2"
  }
}
